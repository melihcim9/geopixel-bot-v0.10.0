            localStorage.setItem("gp_place_transparent", e.target.checked);
            ghostPixelData = null;
            log(LOG_LEVELS.info, `Transparent pixels: ${e.target.checked}`);
        });

        document.getElementById('gp-toggle-free').addEventListener('change', (e) => {
            usw.ghostBot.placeFreeColors = e.target.checked;
            localStorage.setItem("gp_place_free", e.target.checked);
            ghostPixelData = null;
            log(LOG_LEVELS.info, `Place free colors: ${e.target.checked}`);
        });

        document.getElementById('gp-toggle-sound').addEventListener('change', (e) => {
            usw.ghostBot.soundEnabled = e.target.checked;
            localStorage.setItem("gp_sound", e.target.checked);
            log(LOG_LEVELS.info, `Sound notification: ${e.target.checked}`);
        });

        document.getElementById('gp-toggle-owned').addEventListener('change', (e) => {
            usw.ghostBot.onlyOwnedColors = e.target.checked;
            localStorage.setItem("gp_only_owned", e.target.checked);
            ghostPixelData = null;
            log(LOG_LEVELS.info, `Sadece hesap renkleri: ${e.target.checked}`);
            detectOwnedColors(false);
        });

        document.getElementById('gp-detect-btn').addEventListener('click', () => {
            detectOwnedColors();
        });

        document.getElementById('gp-ignore-btn').addEventListener('click', () => {
            const val = document.getElementById('gp-ignore-input').value;
            usw.ghostBot.ignoreColors(val);
        });

        // Canli istatistik guncellemesi
        setInterval(() => {
            const energyEl = document.getElementById('gp-energy-display');
            if (energyEl) {
                try {
                    energyEl.textContent = (typeof currentEnergy !== 'undefined' && currentEnergy !== null) ? currentEnergy : '?';
                } catch (e) { energyEl.textContent = '?'; }
            }
            const rateEl = document.getElementById('gp-rate-display');
            const timeEl = document.getElementById('gp-time-display');
            if (statsStartTime && rateEl && timeEl) {
                const elapsedMin = (Date.now() - statsStartTime) / 60000;
                const elapsedSec = Math.floor((Date.now() - statsStartTime) / 1000);
                const mm = String(Math.floor(elapsedSec / 60)).padStart(2, '0');
                const ss = String(elapsedSec % 60).padStart(2, '0');
                timeEl.textContent = `${mm}:${ss}`;
                rateEl.textContent = elapsedMin > 0.02 ? Math.round(sessionPlacedCount / elapsedMin) : 0;
            }
            const barEl = document.getElementById('gp-progress-bar');
            const txtEl = document.getElementById('gp-progress-text');
            if (barEl && txtEl && statsTotal > 0) {
                const done = Math.max(0, statsTotal - statsRemaining);
                const pct = Math.min(100, Math.round((done / statsTotal) * 100));
                barEl.style.width = pct + '%';
                txtEl.textContent = `${pct}% (${done}/${statsTotal})`;
            }
        }, 1000);

        // Colors global'i hazir olunca otomatik algila (max 20 sn bekle)
        let tries = 0;
        const detectTimer = setInterval(() => {
            if (readRawColors()) {
                clearInterval(detectTimer);
                detectOwnedColors(false);
            } else if (++tries > 40) {
                clearInterval(detectTimer);
                const box = document.getElementById('gp-owned-swatches');
                if (box) box.innerHTML = '<span style="color:#f87171; font-size:10px;">Renk listesi bulunamadi. Giris yaptigindan emin ol.</span>';
            }
        }, 500);
    }

    const tryRelog = withErrorHandling(async function () {
        tokenUser = "";

        if (GOOGLE_CLIENT_ID) {
            log(LOG_LEVELS.info, "attempting relog with google");
            await new Promise((resolve) => {
                google.accounts.id.initialize({
                    client_id: GOOGLE_CLIENT_ID,
                    callback: async (e) => {
                        const r = await fetch("/auth/google", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ token: e.credential }),
                        });
                        if (!r.ok) return log(LOG_LEVELS.info, "Google authentication failed");
                        const data = await r.json();
                        await logIn(data);

                        resolve();
                    },
                    auto_select: true,
                    context: "signin",
                });

                google.accounts.id.prompt();
            });
        }

        log(LOG_LEVELS.info, `Relog ${tokenUser.length ? "successful" : "failed"}`);
        return !!tokenUser.length;
    });

    function getGhostImageData() {
        if (!ghostImageOriginalData || !ghostImageTopLeft) return null;
        return canvasToImageData(
            ghostImageOriginalData,
            ghostImageTopLeft.gridX,
            ghostImageTopLeft.gridY
        );
    }

    function setGhostPixelData() {
        ghostData = Array.from(getGhostImageData().values());

        // Hesap renkleri filtresi (sadece sahip olunan renkler)
        let ownedIds = null;
        if (usw.ghostBot.onlyOwnedColors) {
            ownedIds = getOwnedColorIds();
            if (!ownedIds && !ownedWarned) {
                ownedWarned = true;
                log(LOG_LEVELS.warn, "Hesap renk listesi (Colors) okunamadi! Filtre devre disi birakildi.");
            }
        }
        ownedColorSignature = getOwnedColorsSignature();

        ghostPixelData = ghostData.filter((d) => {
            return (
                (usw.ghostBot.placeTransparentGhostPixels || d.color.a > 0) &&
                (usw.ghostBot.placeFreeColors || !FREE_COLOR_IDS.has(d.color.id())) &&
                (ownedIds === null || ownedIds.includes(d.color.id())) &&
                !ignoredColors.has(d.color.id())
            );
        });
    }

    function getGhostPixelData() {
        if (!ghostPixelData) setGhostPixelData();
        return ghostPixelData;
    }

    function getGhostData() {
        if (!ghostData) setGhostPixelData();
        return ghostData;
    }

    const updatePlacedPixels = withErrorHandling(async function () {
        const ghostData = getGhostData();
        const topLeft = ghostData[0].gridCoord;
        const bottomRight = ghostData[ghostData.length - 1].gridCoord;

        const tileCoords = getAllCoordsBetween(topLeft, bottomRight, SYNC_TILE_SIZE);

        async function fetchTiles(tiles) {
            return await fetch(`/GetPixelsCached`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    Tiles: tiles.map((t) => ({ ...t, timestamp: lastServerTimestamp })),
                }),
            });
        }

        for (let i = 0; i < tileCoords.length; i += 9) {
            const r = await (await fetchTiles(tileCoords.slice(i, i + 9))).json();
            if (r.ServerTimestamp) lastServerTimestamp = r.ServerTimestamp;
            for (const [n, tile] of Object.entries(r.Tiles)) {
                const coord = n.split("_").map(Number).filter(Number.isFinite);
                if (tile.Type == "delta" && tile.Pixels.length)
                    for (const p of tile.Pixels) {
                        const [gridX, gridY, color, userId] = p;
                        placedPixelData.set(`${gridX},${gridY}`, {
                            gridCoord: { x: gridX, y: gridY },
                            color: new Color(color),
                        });
                    }
                else if (tile.Type == "full") {
                    const canvasData = await webpToCanvasData(tile.ColorWebP, SYNC_TILE_SIZE, SYNC_TILE_SIZE);
                    canvasToImageData(canvasData, +coord[0], +coord[1] + SYNC_TILE_SIZE - 1, placedPixelData);
                }
            }
        }
    });

    Array.prototype.orderGhostPixels = function () {
        const method = usw.ghostBot.fillMethod || "mixed";

        if (method === "blocks_first") {
            // En cok blok cikaran rengi bastan sona bitirir, sonra siradakine gecer
            const freqMap = new Map();
            this.forEach((pixel) => {
                const val = pixel.color.id();
                freqMap.set(val, (freqMap.get(val) || 0) + 1);
            });
            return this.sort((a, b) => {
                const diff = freqMap.get(b.color.id()) - freqMap.get(a.color.id());
                if (diff !== 0) return diff;
                return (a.gridCoord.x - b.gridCoord.x) || (b.gridCoord.y - a.gridCoord.y);
            });
        } else if (method === "frequency") {
            const freqMap = new Map();
            this.forEach((pixel) => {
                const val = pixel.color.id();
                freqMap.set(val, (freqMap.get(val) || 0) + 1);
            });
            return this.sort((a, b) => {
                const aFreq = freqMap.get(a.color.id());
                const bFreq = freqMap.get(b.color.id());
                return aFreq - bFreq;
            });
        } else if (method === "mixed") {
            // Ucretsiz ve ucretli pikselleri karistir, harmanla
            const freeGroup = this.filter((d) => FREE_COLOR_IDS.has(d.color.id())).sort(() => Math.random() - 0.5);
            const paidGroup = this.filter((d) => !FREE_COLOR_IDS.has(d.color.id())).sort(() => Math.random() - 0.5);
            const comp = `${freeGroup.length}/${paidGroup.length}`;
            if (comp !== lastMixedComp) {
                lastMixedComp = comp;
                log(LOG_LEVELS.info, `Mix mode: ${freeGroup.length} free + ${paidGroup.length} paid pixels harmanlandi.`);
            }
            return interleaveGroups([freeGroup, paidGroup]);
        } else if (method === "random") {
            return this.sort(() => Math.random() - 0.5);
        } else if (method === "top_to_bottom") {
            return this.sort((a, b) => b.gridCoord.y - a.gridCoord.y || a.gridCoord.x - b.gridCoord.x);
        } else if (method === "bottom_to_top") {
            return this.sort((a, b) => a.gridCoord.y - b.gridCoord.y || a.gridCoord.x - b.gridCoord.x);
        } else if (method === "left_to_right") {
            return this.sort((a, b) => a.gridCoord.x - b.gridCoord.x || b.gridCoord.y - a.gridCoord.y);
        } else if (method === "right_to_left") {
            return this.sort((a, b) => b.gridCoord.x - a.gridCoord.x || b.gridCoord.y - a.gridCoord.y);
        } else if (method === "diagonal") {
            return this.sort((a, b) => (a.gridCoord.x + a.gridCoord.y) - (b.gridCoord.x + b.gridCoord.y));
        } else if (method === "nearest") {
            if (this.length > 50000) {
                // O(n^2) — milyonlarca pikselde sekme donar, random'a dus
                log(LOG_LEVELS.warn, `Nearest modu ${this.length.toLocaleString()} piksel icin cok yavas, random'a dusuldu.`);
                return this.sort(() => Math.random() - 0.5);
            }
            let sorted = [];
            let current = { x: this[0]?.gridCoord.x || 0, y: this[0]?.gridCoord.y || 0 };
            let remaining = [...this];
            while (remaining.length > 0) {
                remaining.sort((a, b) => {
                    const distA = Math.hypot(a.gridCoord.x - current.x, a.gridCoord.y - current.y);
                    const distB = Math.hypot(b.gridCoord.x - current.x, b.gridCoord.y - current.y);
                    return distA - distB;
                });
                let next = remaining.shift();
                sorted.push(next);
                current = next.gridCoord;
            }
            return sorted;
        }
        return this;
    };

    const getPixelsToPlace = withErrorHandling(async function () {
        // Oyun icinde yeni renk satin aldiysan listeyi otomatik tazele
        const sig = getOwnedColorsSignature();
        if (sig && sig !== ownedColorSignature) {
            log(LOG_LEVELS.info, "Hesap renkleri degismis, liste guncelleniyor...");
            ghostPixelData = null;
            if (statsStartTime) statsTotal = getGhostPixelData().length;
        }

        await updatePlacedPixels();

        return getGhostPixelData()
            .orderGhostPixels()
            .filter((d) => {
                const placedPixel = placedPixelData.get(`${d.gridCoord.x},${d.gridCoord.y}`);
                return !placedPixel || placedPixel.color.id() !== d.color.id();
            });
    });

    const sendPixels = withErrorHandling(async function (pixels) {
        if (!pixels || pixels.length === 0) return;
        const r = await fetch("https://geopixels.net/PlacePixel", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                Token: tokenUser,
                Subject: subject,
                UserId: userID,
                Pixels: pixels.map((c) => ({ ...c, UserId: userID })),
            }),
        });
        if (!r.ok) {
            log(LOG_LEVELS.warn, "Failed to place pixels. : " + (await r.text()));
            if (r.status == 401 && (await tryRelog())) await sendPixels(pixels);
        } else {
            sessionPlacedCount += pixels.length;
            const counterEl = document.getElementById("gp-placed-counter");
            if (counterEl) counterEl.textContent = sessionPlacedCount;
            if (usw.ghostBot.soundEnabled) playBeep(880, 0.12);
            log(LOG_LEVELS.info, `Placed ${pixels.length} pixels! (Total: ${sessionPlacedCount})`);
        }
    });

    let stopWhileLoop = false;
    let promiseResolve;

    const startGhostBot = withErrorHandling(async function () {
        if (isRunning) {
            log(LOG_LEVELS.warn, "Bot zaten calisiyor! Once Stop'a bas.");
            return;
        }
        if (!ghostImage || !ghostImageOriginalData || !ghostImageTopLeft) {
            log(LOG_LEVELS.warn, "Ghost image not loaded.");
            return;
        }
        stopWhileLoop = false;
        isRunning = true;
        statsStartTime = Date.now();
        lastMixedComp = "";
        try {
            statsTotal = getGhostPixelData().length;
            statsRemaining = statsTotal;
            log(LOG_LEVELS.info, `Hedef: ${statsTotal.toLocaleString()} piksel (${usw.ghostBot.onlyOwnedColors ? "sadece hesap renkleri" : "tum renkler"}).`);

            while (!stopWhileLoop) {
                const targetThreshold = usw.ghostBot.targetEnergyThreshold;

                // Trigger energy check
                if (currentEnergy < targetThreshold) {
                    log(LOG_LEVELS.info, `Energy (${currentEnergy}/${targetThreshold}). Waiting for refill...`);
                    setStatus("Enerji bekleniyor", "#facc15");

                    // Poll energy state every 3 seconds until threshold is met or stopped
                    while (!stopWhileLoop && currentEnergy < usw.ghostBot.targetEnergyThreshold) {
                        await new Promise((resolve) => {
                            promiseResolve = resolve;
                            setTimeout(resolve, 3000);
                        });
                    }
                }

                if (stopWhileLoop) break;
                setStatus("Calisiyor", "#22c55e");

                const pixelsToPlace = await getPixelsToPlace();
                if (!pixelsToPlace) break; // hata olustu, disarida loglandi
                if (pixelsToPlace.length === 0) {
                    statsRemaining = 0;
                    log(LOG_LEVELS.info, "All pixels are correctly placed.");
                    setStatus("Tamamlandi!", "#4ade80");
                    if (usw.ghostBot.soundEnabled) playBeep(1320, 0.3);
                    break;
                }

                // Dump all available current energy at once
                const batchSize = Math.min(currentEnergy, pixelsToPlace.length);
                const pixelsThisRequest = pixelsToPlace.slice(0, batchSize);
                if (pixelsThisRequest.length === 0) {
                    // Enerji kontrolu ile gonderim arasinda enerji bitti, kisa bekle ve donguye don
                    await new Promise((resolve) => {
                        promiseResolve = resolve;
                        setTimeout(resolve, 2000);
                    });
                    continue;
                }
                statsRemaining = pixelsToPlace.length - pixelsThisRequest.length;
                log(LOG_LEVELS.info, `Trigger met (${currentEnergy} energy). Placing ${pixelsThisRequest.length} pixels...`);

                await sendPixels(
                    pixelsThisRequest.map((d) => ({
                        GridX: d.gridCoord.x,
                        GridY: d.gridCoord.y,
                        Color: d.color.id(),
                    }))
                );

                if (!tokenUser) {
                    log(LOG_LEVELS.warn, "Logged out => stopping bot.");
                    break;
                }
                if (pixelsToPlace.length === pixelsThisRequest.length) {
                    statsRemaining = 0;
                    log(LOG_LEVELS.info, "All pixels are correctly placed.");
                    setStatus("Tamamlandi!", "#4ade80");
                    if (usw.ghostBot.soundEnabled) playBeep(1320, 0.3);
                    break;
                }

                // Small delay to let game state update before re-checking energy loop
                await new Promise((resolve) => {
                    promiseResolve = resolve;
                    setTimeout(resolve, 2000);
                });
            }
        } finally {
            isRunning = false;
            setStatus("Durdu", "#ef4444");
        }
    });

    window.addEventListener('load', () => {
        setTimeout(createUI, 1500);
    });

    log(
        LOG_LEVELS.info,
        "GhostPixel Bot v0.10.1 loaded: Owned-color detection, Mix & Blocks-First modes, live stats."
    );
})();
