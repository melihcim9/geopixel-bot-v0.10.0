// Gruplari orantisel olarak harmanlar (buyuk gruptan daha sik alir)
function interleaveGroups(groups) {
    const result = [];
    const total = groups.reduce((s, g) => s + g.length, 0);
    const idx = groups.map(() => 0);
    while (result.length < total) {
        let best = -1, bestRatio = -1;
        groups.forEach((g, i) => {
            if (idx[i] < g.length) {
                const ratio = (g.length - idx[i]) / g.length;
                if (ratio > bestRatio) { bestRatio = ratio; best = i; }
            }
        });
        result.push(groups[best][idx[best]++]);
    }
    return result;
}

